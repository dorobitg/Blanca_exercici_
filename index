<!DOCTYPE html>
<html lang="ca">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>El meu camí de força</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --verd-clar:#BAC095;
    --verd-fosc:#3D4127;
    --negre:#000000;
    --blanc:#FFFFFF;
    --verd-clar-suau: rgba(186,192,149,0.35);
    --verd-fosc-suau: rgba(61,65,39,0.08);
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    font-family:'Inter', sans-serif;
    background:var(--blanc);
    color:var(--verd-fosc);
    line-height:1.5;
  }
  h1,h2,h3,h4{
    font-family:'Fraunces', serif;
    color:var(--verd-fosc);
    margin:0 0 .3em 0;
  }
  .wrap{max-width:960px;margin:0 auto;padding:0 20px 80px;}

  /* HEADER */
  header.hero{
    background:var(--verd-fosc);
    color:var(--blanc);
    padding:48px 20px 64px;
    position:relative;
    overflow:hidden;
  }
  header.hero::after{
    content:"";
    position:absolute;
    right:-60px; top:-60px;
    width:260px;height:260px;
    border-radius:50%;
    background:var(--verd-clar);
    opacity:.18;
  }
  .hero-inner{max-width:960px;margin:0 auto;position:relative;}
  .eyebrow{
    text-transform:uppercase;
    letter-spacing:.14em;
    font-size:.72rem;
    color:var(--verd-clar);
    font-weight:600;
    margin-bottom:10px;
  }
  header.hero h1{color:var(--blanc);font-size:2.3rem;font-weight:600;max-width:620px;}
  header.hero p{max-width:560px;color:var(--verd-clar);font-size:1rem;margin-top:8px;}
  .medical-note{
    margin-top:24px;
    background:rgba(255,255,255,0.08);
    border:1px solid rgba(255,255,255,0.25);
    border-radius:12px;
    padding:14px 18px;
    font-size:.88rem;
    color:var(--blanc);
    max-width:640px;
  }
  .medical-note strong{color:var(--verd-clar);}

  /* WEEK PROGRESS RING */
  .week-progress{
    position:absolute; right:0; top:10px;
    display:flex; flex-direction:column; align-items:center;
    gap:6px;
  }
  .ring{width:92px;height:92px;}
  .ring-label{font-size:.72rem;color:var(--verd-clar);text-align:center;}
  @media(max-width:700px){ .week-progress{position:static;margin-top:20px;} }

  /* SECTIONS */
  section{margin-top:46px;}
  .section-head{display:flex;align-items:baseline;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:18px;}
  .section-head h2{font-size:1.4rem;}
  .section-head .tag{font-size:.75rem;text-transform:uppercase;letter-spacing:.1em;color:var(--verd-fosc);opacity:.55;font-weight:600;}

  /* CARD */
  .card{
    background:var(--blanc);
    border:1px solid var(--verd-fosc-suau);
    border-radius:16px;
    padding:22px;
  }

  /* SETTINGS */
  .settings-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;}
  @media(max-width:700px){.settings-grid{grid-template-columns:1fr;}}
  .settings-grid label{display:block;font-size:.82rem;font-weight:600;margin-bottom:6px;}
  .settings-grid select{
    width:100%;padding:9px 10px;border-radius:8px;border:1px solid var(--verd-fosc);
    font-family:'Inter';font-size:.9rem;background:var(--blanc);color:var(--verd-fosc);
  }
  .settings-day-desc{font-size:.76rem;opacity:.65;margin-top:4px;}
  .btn{
    border:none;border-radius:999px;padding:11px 22px;font-weight:600;font-size:.9rem;
    cursor:pointer;font-family:'Inter';transition:transform .15s ease, opacity .15s ease;
  }
  .btn-primary{background:var(--verd-fosc);color:var(--blanc);}
  .btn-primary:hover{transform:translateY(-1px);}
  .btn-secondary{background:var(--verd-clar-suau);color:var(--verd-fosc);}
  .btn-ghost{background:transparent;color:var(--verd-fosc);border:1px solid var(--verd-fosc);}
  .btn:disabled{opacity:.4;cursor:not-allowed;transform:none;}
  .btn-row{display:flex;gap:10px;flex-wrap:wrap;margin-top:16px;}

  /* TODAY CARD */
  .today-card{
    display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap;
    background:var(--verd-clar-suau);
  }
  .today-card .day-title{font-size:1.15rem;font-weight:600;}
  .today-card .day-sub{font-size:.85rem;opacity:.7;}

  /* CALENDAR */
  .cal-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;}
  .cal-header button{background:none;border:1px solid var(--verd-fosc);border-radius:8px;padding:6px 12px;cursor:pointer;color:var(--verd-fosc);font-family:'Inter';font-weight:600;}
  .cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:6px;}
  .cal-dow{font-size:.7rem;text-transform:uppercase;letter-spacing:.06em;text-align:center;opacity:.55;font-weight:600;padding-bottom:4px;}
  .cal-cell{
    aspect-ratio:1/1;border-radius:10px;display:flex;flex-direction:column;align-items:center;justify-content:center;
    font-size:.82rem;position:relative;border:1px solid transparent;
  }
  .cal-cell.empty{visibility:hidden;}
  .cal-cell.training{background:var(--verd-clar-suau);font-weight:600;}
  .cal-cell.today{border-color:var(--verd-fosc);}
  .cal-cell.done{background:var(--verd-fosc);color:var(--blanc);}
  .cal-cell .dtag{font-size:.6rem;opacity:.75;margin-top:1px;}
  .cal-legend{display:flex;gap:16px;margin-top:14px;flex-wrap:wrap;font-size:.78rem;opacity:.75;}
  .legend-dot{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:6px;vertical-align:middle;}

  /* EXERCISE LIST */
  .day-picker{display:flex;gap:10px;margin-bottom:18px;flex-wrap:wrap;}
  .day-picker button{
    flex:1;min-width:150px;border-radius:12px;border:1px solid var(--verd-fosc);background:var(--blanc);
    color:var(--verd-fosc);padding:12px;font-family:'Inter';font-weight:600;cursor:pointer;font-size:.85rem;
  }
  .day-picker button.active{background:var(--verd-fosc);color:var(--blanc);}

  .session-bar{
    display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap;
    background:var(--verd-fosc);color:var(--blanc);border-radius:14px;padding:16px 20px;margin-bottom:18px;
  }
  .session-bar .st{font-size:.8rem;color:var(--verd-clar);}
  .session-bar .val{font-family:'Fraunces';font-size:1.3rem;}

  .exercise-note{
    background:var(--verd-clar-suau);border-radius:10px;padding:12px 16px;font-size:.85rem;margin-bottom:18px;
  }

  .exercise{
    display:flex;gap:16px;align-items:center;border:1px solid var(--verd-fosc-suau);border-radius:14px;
    padding:14px;margin-bottom:12px;transition:background .2s ease;
  }
  .exercise.done{background:var(--verd-clar-suau);}
  .exercise svg{flex-shrink:0;width:64px;height:96px;}
  .exercise .ex-body{flex:1;}
  .exercise .ex-name{font-weight:600;font-size:1rem;}
  .exercise .ex-desc{font-size:.83rem;opacity:.75;margin-top:2px;}
  .ex-check{
    width:30px;height:30px;border-radius:50%;border:2px solid var(--verd-fosc);flex-shrink:0;
    display:flex;align-items:center;justify-content:center;cursor:pointer;font-weight:700;background:var(--blanc);
  }
  .exercise.done .ex-check{background:var(--verd-fosc);color:var(--blanc);}

  .toast{
    position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(20px);
    background:var(--verd-fosc);color:var(--blanc);padding:13px 22px;border-radius:999px;
    font-size:.88rem;font-weight:600;opacity:0;transition:all .35s ease;pointer-events:none;z-index:50;
    box-shadow:0 8px 24px rgba(0,0,0,.2);
  }
  .toast.show{opacity:1;transform:translateX(-50%) translateY(0);}

  /* TIMESTAMP MODAL */
  .overlay{
    position:fixed;inset:0;background:rgba(0,0,0,.45);display:none;align-items:center;justify-content:center;z-index:60;padding:20px;
  }
  .overlay.show{display:flex;}
  .modal{
    background:var(--blanc);border-radius:16px;padding:26px;max-width:380px;width:100%;
  }
  .modal h3{margin-bottom:8px;}
  .modal p{font-size:.85rem;opacity:.75;margin-bottom:14px;}
  .modal input[type=datetime-local]{
    width:100%;padding:10px;border-radius:8px;border:1px solid var(--verd-fosc);font-family:'Inter';margin-bottom:16px;
  }
  .modal input[type=text]{
    width:100%;padding:10px;border-radius:8px;border:1px solid var(--verd-fosc);font-family:'Inter';margin-bottom:12px;font-size:1rem;letter-spacing:.02em;
  }
  .code-actions{display:flex;gap:10px;flex-wrap:wrap;}
  .code-hint{font-size:.78rem;opacity:.6;margin-top:10px;}
  .sync-status{font-size:.72rem;opacity:.55;}

  /* STATS */
  .stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:22px;}
  @media(max-width:700px){.stats-grid{grid-template-columns:repeat(2,1fr);}}
  .stat-box{background:var(--verd-clar-suau);border-radius:14px;padding:16px;text-align:center;}
  .stat-box .num{font-family:'Fraunces';font-size:1.7rem;font-weight:600;}
  .stat-box .lbl{font-size:.72rem;text-transform:uppercase;letter-spacing:.06em;opacity:.65;margin-top:2px;}

  .bars{display:flex;align-items:flex-end;gap:10px;height:140px;margin-top:10px;padding:0 4px;}
  .bar-col{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;height:100%;}
  .bar{width:100%;background:var(--verd-fosc);border-radius:6px 6px 0 0;min-height:3px;transition:height .3s ease;}
  .bar-col .bl{font-size:.65rem;opacity:.6;margin-top:6px;}

  table.history{width:100%;border-collapse:collapse;margin-top:8px;font-size:.85rem;}
  table.history th{text-align:left;font-size:.7rem;text-transform:uppercase;letter-spacing:.06em;opacity:.55;padding:6px 8px;border-bottom:1px solid var(--verd-fosc-suau);}
  table.history td{padding:9px 8px;border-bottom:1px solid var(--verd-fosc-suau);}
  .empty-state{opacity:.6;font-size:.85rem;text-align:center;padding:24px 0;}

  footer{text-align:center;padding:30px 20px;font-size:.75rem;opacity:.5;}
</style>
</head>
<body>

<header class="hero">
  <div class="hero-inner">
    <div class="eyebrow">Seguiment d'activitat física</div>
    <h1>El meu camí de força</h1>
    <p>Tres sessions setmanals per recuperar mobilitat i força, al teu ritme.</p>
    <div class="medical-note">
      <strong>Abans de començar:</strong> consulta amb el teu equip mèdic o fisioterapeuta quins exercicis són adequats per a la teva situació. Adapta sempre la intensitat i el pes a com et trobis. Si sents dolor, tibantor excessiva o inflor, atura't.
    </div>
    <div class="week-progress" id="weekProgress">
      <svg class="ring" viewBox="0 0 100 100">
        <circle cx="50" cy="50" r="42" fill="none" stroke="rgba(255,255,255,0.2)" stroke-width="10"/>
        <circle id="ringFg" cx="50" cy="50" r="42" fill="none" stroke="#BAC095" stroke-width="10" stroke-linecap="round" stroke-dasharray="264" stroke-dashoffset="264" transform="rotate(-90 50 50)"/>
        <text id="ringText" x="50" y="56" text-anchor="middle" font-family="Fraunces" font-size="22" fill="#FFFFFF">0/3</text>
      </svg>
      <div class="ring-label">Sessions<br>aquesta setmana</div>
    </div>
  </div>
</header>

<div class="wrap">

  <!-- CONFIGURACIÓ -->
  <section>
    <div class="section-head">
      <h2>Configuració dels dies</h2>
      <span class="tag">Editable</span>
    </div>
    <div class="card">
      <div class="settings-grid">
        <div>
          <label>Dia 1 — Abdominals, braços, espatlles i trapezi</label>
          <select id="sel-day-0"></select>
          <div class="settings-day-desc">Zona superior del cos</div>
        </div>
        <div>
          <label>Dia 2 — Esquena</label>
          <select id="sel-day-1"></select>
          <div class="settings-day-desc">Mobilitat i força de l'esquena</div>
        </div>
        <div>
          <label>Dia 3 — Cames i tren inferior</label>
          <select id="sel-day-2"></select>
          <div class="settings-day-desc">Cames, glutis i bessons</div>
        </div>
      </div>
      <div class="btn-row">
        <button class="btn btn-primary" id="saveSettingsBtn">Desa la configuració</button>
      </div>
    </div>
  </section>

  <!-- AVUI -->
  <section>
    <div class="section-head">
      <h2>Sessió d'avui</h2>
      <span class="tag" id="todayDate"></span>
    </div>
    <div class="card today-card">
      <div>
        <div class="day-title" id="todayTitle">Carregant…</div>
        <div class="day-sub" id="todaySub"></div>
      </div>
      <button class="btn btn-primary" id="startTodayBtn">Comença la sessió</button>
    </div>
    <div class="btn-row" id="freeSessionRow">
      <span style="font-size:.82rem;opacity:.65;align-self:center;">O comença una sessió lliure:</span>
    </div>
  </section>

  <!-- CALENDARI -->
  <section>
    <div class="section-head">
      <h2>Calendari</h2>
    </div>
    <div class="card">
      <div class="cal-header">
        <button id="prevMonth">&larr;</button>
        <h3 id="calMonthLabel"></h3>
        <button id="nextMonth">&rarr;</button>
      </div>
      <div class="cal-grid" id="calGrid"></div>
      <div class="cal-legend">
        <span><span class="legend-dot" style="background:var(--verd-clar-suau);border:1px solid var(--verd-fosc);"></span>Dia d'entrenament</span>
        <span><span class="legend-dot" style="background:var(--verd-fosc);"></span>Sessió completada</span>
        <span><span class="legend-dot" style="background:transparent;border:1px solid var(--verd-fosc);"></span>Avui</span>
      </div>
    </div>
  </section>

  <!-- SESSIÓ ACTIVA -->
  <section id="sessionSection" style="display:none;">
    <div class="section-head">
      <h2 id="sessionTitle">Sessió</h2>
      <span class="tag" id="sessionExCount"></span>
    </div>
    <div class="session-bar">
      <div>
        <div class="st">Inici de la sessió</div>
        <div class="val" id="sessionStartVal">—</div>
      </div>
      <div>
        <div class="st">Exercicis fets</div>
        <div class="val" id="sessionDoneVal">0 / 0</div>
      </div>
      <button class="btn btn-secondary" id="cancelSessionBtn" style="background:rgba(255,255,255,.15);color:#fff;">Cancel·la</button>
    </div>
    <div class="exercise-note" id="dayNote"></div>
    <div id="exerciseList"></div>
    <div class="btn-row">
      <button class="btn btn-primary" id="finishSessionBtn">Finalitza la sessió</button>
    </div>
  </section>

  <!-- ESTADÍSTIQUES -->
  <section>
    <div class="section-head">
      <h2>Estadístiques</h2>
    </div>
    <div class="stats-grid">
      <div class="stat-box"><div class="num" id="statTotal">0</div><div class="lbl">Sessions totals</div></div>
      <div class="stat-box"><div class="num" id="statMinutes">0</div><div class="lbl">Minuts totals</div></div>
      <div class="stat-box"><div class="num" id="statAvg">0</div><div class="lbl">Mitjana min/sessió</div></div>
      <div class="stat-box"><div class="num" id="statWeek">0/3</div><div class="lbl">Aquesta setmana</div></div>
    </div>
    <div class="card">
      <h3 style="font-size:1rem;">Minuts per setmana (últimes 8)</h3>
      <div class="bars" id="barsChart"></div>
    </div>
    <div class="card" style="margin-top:16px;">
      <h3 style="font-size:1rem;">Historial de sessions</h3>
      <div id="historyWrap"></div>
    </div>
  </section>

</div>

<footer>El meu camí de força — dades sincronitzades entre dispositius amb el teu codi personal (<span id="footerCode">—</span>). <span class="sync-status" id="syncStatus"></span></footer>

<div class="toast" id="toast"></div>

<div class="overlay show" id="codeOverlay">
  <div class="modal">
    <h3>El teu codi personal</h3>
    <p>Aquest codi vincula les teves dades entre dispositius. Introdueix el mateix codi a cada dispositiu des d'on vulguis accedir al teu historial. Si és el primer cop, crea'n un i desa'l en un lloc seguir per fer-lo servir més endavant.</p>
    <input type="text" id="codeInput" placeholder="p. ex. anna-2026" autocomplete="off">
    <div class="code-actions">
      <button class="btn btn-primary" id="codeConfirm">Entra</button>
      <button class="btn btn-ghost" id="codeGenerate">Genera'n un de nou</button>
    </div>
    <div class="code-hint">Es desa a aquest navegador perquè no l'hagis de repetir cada vegada. Per canviar-lo, esborra les dades del lloc al navegador.</div>
  </div>
</div>

<div class="overlay" id="tsOverlay">
  <div class="modal">
    <h3 id="tsTitle">Inici de la sessió</h3>
    <p id="tsDesc">Confirma l'hora d'inici. Pots ajustar-la si cal.</p>
    <input type="datetime-local" id="tsInput">
    <div class="btn-row">
      <button class="btn btn-primary" id="tsConfirm">Confirma</button>
      <button class="btn btn-ghost" id="tsCancel">Cancel·la</button>
    </div>
  </div>
</div>

<script>
/* ---------- DADES ---------- */
const DOW_NAMES = ["Dilluns","Dimarts","Dimecres","Dijous","Divendres","Dissabte","Diumenge"];
const MONTH_NAMES = ["Gener","Febrer","Març","Abril","Maig","Juny","Juliol","Agost","Setembre","Octubre","Novembre","Desembre"];

const exercisesData = {
  1: {
    title: "Abdominals, braços, espatlles i trapezi",
    note: "Si sents tibantor, dolor o inflor al braç o al pit, para l'exercici i consulta amb el teu equip mèdic.",
    items: [
      {name:"Bàscula pèlvica", desc:"2 sèries x 12 repeticions. Ajaguda, corba i aplana suaument la zona lumbar contraient l'abdomen.", zone:"abdomen", view:"front"},
      {name:"Contracció abdominal en assegut", desc:"3 sèries x 10 respiracions. Asseguda, expira contraient l'abdomen 3 segons.", zone:"abdomen", view:"front"},
      {name:"Cercles de braços", desc:"2 sèries x 10 cercles per banda, moviment petit i controlat.", zone:"shoulders", view:"front"},
      {name:"Flexió de bíceps amb banda lleugera", desc:"2 sèries x 12 repeticions amb una banda elàstica de resistència baixa.", zone:"arms", view:"front"},
      {name:"Encongiment d'espatlles", desc:"2 sèries x 12 repeticions. Eleva les espatlles cap a les orelles i baixa lentament.", zone:"trapezius", view:"back"}
    ]
  },
  2: {
    title: "Esquena",
    note: "Treballa dins un rang de moviment còmode; l'objectiu és mobilitat, no intensitat.",
    items: [
      {name:"Gat-vaca", desc:"2 sèries x 10 repeticions. A quatre grapes, alterna arquejar i arrodonir l'esquena.", zone:"back", view:"back"},
      {name:"Superman suau", desc:"2 sèries x 10 repeticions. Ajaguda bocaterrosa, eleva lleugerament un braç i la cama oposada.", zone:"back", view:"back"},
      {name:"Rem amb banda elàstica assegut", desc:"2 sèries x 12 repeticions. Estira la banda cap enrere ajuntant els omòplats.", zone:"back", view:"back"},
      {name:"Àngels de paret", desc:"2 sèries x 10 repeticions. Amb l'esquena a la paret, puja i baixa els braços en forma de V.", zone:"trapezius", view:"back"},
      {name:"Extensió suau de tronc", desc:"2 sèries x 10 repeticions per banda, a quatre grapes, sense forçar l'amplitud.", zone:"back", view:"back"}
    ]
  },
  3: {
    title: "Cames i tren inferior",
    note: "Fes servir un suport estable (cadira o paret) si notes inestabilitat o fatiga.",
    items: [
      {name:"Sentadella a cadira", desc:"2 sèries x 10 repeticions. Asseu-te i aixeca't d'una cadira amb control.", zone:"legs", view:"front"},
      {name:"Pont de malucs", desc:"2 sèries x 12 repeticions. Ajaguda, eleva els malucs contraient els glutis.", zone:"glutes", view:"back"},
      {name:"Elevació de talons", desc:"2 sèries x 15 repeticions. De peu, puja sobre les puntes dels peus.", zone:"calves", view:"front"},
      {name:"Step-up a esglaó baix", desc:"2 sèries x 10 repeticions per cama, sobre un esglaó estable.", zone:"legs", view:"front"},
      {name:"Elevació lateral de cama", desc:"2 sèries x 12 repeticions per cama, de peu, subjectant-te si cal.", zone:"legs", view:"front"}
    ]
  }
};

const MOTIVATIONAL = [
  "Un pas més cap a tu mateixa.",
  "El teu cos t'ho agraeix.",
  "Cada repetició suma.",
  "Estàs construint força, dia a dia.",
  "Vas al teu ritme, i això està bé.",
  "Ho estàs fent molt bé.",
  "La constància és la teva millor aliada.",
  "Un exercici més, un motiu més per sentir-te orgullosa.",
  "El teu esforç d'avui és la teva força de demà.",
  "Escolta el teu cos i celebra cada avenç.",
  "Estàs recuperant el control, exercici a exercici.",
  "Segueix així, ho estàs aconseguint."
];

/* ---------- ESTAT ---------- */
let settings = { trainingDays: [1,3,5] }; // 1=dilluns ... 7=diumenge, ordre = dia1,dia2,dia3
let sessions = [];
let calMonthCursor = new Date();
let activeSession = null; // {dayType, start, checked:Set}
let personalCode = null;

/* ---------- SUPABASE ---------- */
const SUPABASE_URL = "https://tfzeavgpaxrfeclmucnw.supabase.co";
