/* ---------- CODI PERSONAL ---------- */
function slugifyCode(raw){
  return raw.trim().toLowerCase().replace(/\s+/g,'-').replace(/[^a-z0-9-]/g,'').slice(0,60);
}
function randomCode(){
  const words = ["camí","força","verd","clar","estel","arrel","brot","llum","calma","pas"];
  const w = words[Math.floor(Math.random()*words.length)];
  const n = Math.floor(1000 + Math.random()*9000);
  return slugifyCode(w+"-"+n);
}
async function ensureCode(){
  return new Promise((resolve)=>{
    const saved = localStorage.getItem('camiDeForca_code');
    if(saved){
      personalCode = saved;
      document.getElementById('codeOverlay').classList.remove('show');
      resolve();
      return;
    }
    const overlay = document.getElementById('codeOverlay');
    const input = document.getElementById('codeInput');
    overlay.classList.add('show');
    document.getElementById('codeGenerate').onclick = ()=>{
      input.value = randomCode();
    };
    document.getElementById('codeConfirm').onclick = ()=>{
      const val = slugifyCode(input.value || randomCode());
      if(!val) return;
      localStorage.setItem('camiDeForca_code', val);
      personalCode = val;
      overlay.classList.remove('show');
      resolve();
    };
  });
}

/* ---------- STORAGE (Supabase) ---------- */
async function loadSettings(){
  try{
    setSyncStatus("Sincronitzant…");
    const { data, error } = await supabaseClient
      .from('app_settings')
      .select('training_days')
      .eq('code', personalCode)
      .maybeSingle();
    if(error) throw error;
    if(data && data.training_days){
      settings.trainingDays = data.training_days;
    } else {
      await supabaseClient.from('app_settings').insert({ code: personalCode, training_days: settings.trainingDays });
    }
    setSyncStatus("Sincronitzat");
  }catch(e){
    console.error('Error carregant configuració', e);
    setSyncStatus("Sense connexió — mostrant valors per defecte");
  }
}
async function saveSettings(){
  try{
    setSyncStatus("Desant…");
    const { error } = await supabaseClient
      .from('app_settings')
      .upsert({ code: personalCode, training_days: settings.trainingDays, updated_at: new Date().toISOString() });
    if(error) throw error;
    setSyncStatus("Sincronitzat");
  }catch(e){
    console.error('Error desant configuració', e);
    setSyncStatus("No s'ha pogut desar — comprova la connexió");
  }
}
async function loadSessions(){
  try{
    setSyncStatus("Sincronitzant…");
    const { data, error } = await supabaseClient
      .from('sessions')
      .select('*')
      .eq('code', personalCode)
      .order('start_ts', { ascending: true });
    if(error) throw error;
    sessions = (data || []).map(row => ({
      date: row.date,
      dayType: row.day_type,
      start: row.start_ts,
      end: row.end_ts,
      minutes: row.minutes,
      exercisesDone: row.exercises_done,
      totalExercises: row.total_exercises
    }));
    setSyncStatus("Sincronitzat");
  }catch(e){
    console.error('Error carregant sessions', e);
    sessions = [];
    setSyncStatus("Sense connexió — no es veu l'historial");
  }
}
async function saveSessionRecord(record){
  try{
    setSyncStatus("Desant…");
    const { error } = await supabaseClient.from('sessions').insert({
      code: personalCode,
      date: record.date,
      day_type: record.dayType,
      start_ts: record.start,
      end_ts: record.end,
      minutes: record.minutes,
      exercises_done: record.exercisesDone,
      total_exercises: record.totalExercises
    });
    if(error) throw error;
    setSyncStatus("Sincronitzat");
  }catch(e){
    console.error('Error desant sessió', e);
    setSyncStatus("No s'ha pogut desar la sessió — comprova la connexió");
  }
}

