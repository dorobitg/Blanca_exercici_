/* ---------- UTILITATS DE DATA ---------- */
function isoDate(d){ return d.toISOString().slice(0,10); }
function isoWeekday(d){ const wd = d.getDay(); return wd === 0 ? 7 : wd; } // 1=dilluns .. 7=diumenge
function dayTypeForWeekday(wd){
  const idx = settings.trainingDays.indexOf(wd);
  return idx === -1 ? null : idx + 1;
}
function fmtTime(d){
  return d.toLocaleTimeString('ca-ES', {hour:'2-digit', minute:'2-digit'});
}
function toDatetimeLocalValue(d){
  const pad = n => String(n).padStart(2,'0');
  return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
}

/* ---------- CONFIGURACIÓ UI ---------- */
function populateDaySelectors(){
  for(let i=0;i<3;i++){
    const sel = document.getElementById('sel-day-'+i);
    sel.innerHTML = "";
    DOW_NAMES.forEach((name, idx)=>{
      const opt = document.createElement('option');
      opt.value = idx+1;
      opt.textContent = name;
      if(settings.trainingDays[i] === idx+1) opt.selected = true;
      sel.appendChild(opt);
    });
  }
}
document.getElementById('saveSettingsBtn').addEventListener('click', async ()=>{
  const vals = [0,1,2].map(i => parseInt(document.getElementById('sel-day-'+i).value,10));
  settings.trainingDays = vals;
  await saveSettings();
  renderToday();
  renderCalendar();
  showToast("Configuració desada.");
});

/* ---------- SESSIÓ D'AVUI ---------- */
function renderToday(){
  const today = new Date();
  document.getElementById('todayDate').textContent = today.toLocaleDateString('ca-ES', {weekday:'long', day:'numeric', month:'long'});
  const wd = isoWeekday(today);
  const dt = dayTypeForWeekday(wd);
  const startBtn = document.getElementById('startTodayBtn');
  if(dt){
    document.getElementById('todayTitle').textContent = "Dia "+dt+" — "+exercisesData[dt].title;
    document.getElementById('todaySub').textContent = exercisesData[dt].items.length + " exercicis";
    startBtn.disabled = false;
    startBtn.onclick = ()=> openStartModal(dt);
  } else {
    document.getElementById('todayTitle').textContent = "Avui no toca entrenar";
    document.getElementById('todaySub').textContent = "Consulta el calendari per veure els propers dies.";
    startBtn.disabled = true;
  }

  const row = document.getElementById('freeSessionRow');
  row.querySelectorAll('button').forEach(b=>b.remove());
  [1,2,3].forEach(d=>{
    const b = document.createElement('button');
    b.className = 'btn btn-ghost';
    b.textContent = 'Dia '+d;
    b.onclick = ()=> openStartModal(d);
    row.appendChild(b);
  });
}

/* ---------- MODAL DE TIMESTAMP ---------- */
let tsPurpose = null; // 'start' | 'end'
let tsDayType = null;
function openStartModal(dayType){
  tsPurpose = 'start';
  tsDayType = dayType;
  document.getElementById('tsTitle').textContent = "Inici de la sessió — Dia "+dayType;
  document.getElementById('tsDesc').textContent = "Confirma l'hora d'inici. Pots ajustar-la si cal.";
  document.getElementById('tsInput').value = toDatetimeLocalValue(new Date());
  document.getElementById('tsOverlay').classList.add('show');
}
function openEndModal(){
  tsPurpose = 'end';
  document.getElementById('tsTitle').textContent = "Fi de la sessió";
  document.getElementById('tsDesc').textContent = "Confirma l'hora de finalització.";
  document.getElementById('tsInput').value = toDatetimeLocalValue(new Date());
  document.getElementById('tsOverlay').classList.add('show');
}
document.getElementById('tsCancel').addEventListener('click', ()=>{
  document.getElementById('tsOverlay').classList.remove('show');
});
document.getElementById('tsConfirm').addEventListener('click', ()=>{
  const val = document.getElementById('tsInput').value;
  const chosen = val ? new Date(val) : new Date();
  document.getElementById('tsOverlay').classList.remove('show');
  if(tsPurpose === 'start'){
    beginSession(tsDayType, chosen);
  } else {
    finishSession(chosen);
  }
});

/* ---------- SESSIÓ ACTIVA ---------- */
function beginSession(dayType, startDate){
  activeSession = { dayType, start: startDate, checked: new Set() };
  document.getElementById('sessionSection').style.display = 'block';
  document.getElementById('sessionTitle').textContent = "Dia "+dayType+" — "+exercisesData[dayType].title;
  document.getElementById('sessionStartVal').textContent = fmtTime(startDate);
  document.getElementById('dayNote').textContent = exercisesData[dayType].note;
  renderExerciseList();
  document.getElementById('sessionSection').scrollIntoView({behavior:'smooth'});
}
function renderExerciseList(){
  const list = document.getElementById('exerciseList');
  list.innerHTML = "";
  const items = exercisesData[activeSession.dayType].items;
  items.forEach((ex, i)=>{
    const done = activeSession.checked.has(i);
    const row = document.createElement('div');
    row.className = 'exercise' + (done ? ' done' : '');
    row.innerHTML = `
      <div>${figureSVG(ex.zone, ex.view)}</div>
      <div class="ex-body">
        <div class="ex-name">${ex.name}</div>
        <div class="ex-desc">${ex.desc}</div>
      </div>
      <div class="ex-check">${done ? '✓' : ''}</div>
    `;
    row.querySelector('.ex-check').addEventListener('click', ()=>{
      if(activeSession.checked.has(i)){
        activeSession.checked.delete(i);
      } else {
        activeSession.checked.add(i);
        showToast(MOTIVATIONAL[Math.floor(Math.random()*MOTIVATIONAL.length)]);
      }
      renderExerciseList();
    });
    list.appendChild(row);
  });
  document.getElementById('sessionExCount').textContent = activeSession.checked.size + " / " + items.length + " fets";
  document.getElementById('sessionDoneVal').textContent = activeSession.checked.size + " / " + items.length;
}
document.getElementById('finishSessionBtn').addEventListener('click', ()=>{
  if(!activeSession) return;
  openEndModal();
});
document.getElementById('cancelSessionBtn').addEventListener('click', ()=>{
  activeSession = null;
  document.getElementById('sessionSection').style.display = 'none';
});
async function finishSession(endDate){
  if(!activeSession) return;
  const start = activeSession.start;
  let minutes = Math.round((endDate - start) / 60000);
  if(minutes < 0) minutes = 0;
  const record = {
    date: isoDate(start),
    dayType: activeSession.dayType,
    start: start.toISOString(),
    end: endDate.toISOString(),
    minutes: minutes,
    exercisesDone: activeSession.checked.size,
    totalExercises: exercisesData[activeSession.dayType].items.length
  };
  sessions.push(record);
  await saveSessionRecord(record);
  activeSession = null;
  document.getElementById('sessionSection').style.display = 'none';
  showToast("Sessió desada. " + MOTIVATIONAL[Math.floor(Math.random()*MOTIVATIONAL.length)]);
  renderCalendar();
  renderStats();
  renderWeekProgress();
}

/* ---------- TOAST ---------- */
let toastTimer = null;
function showToast(msg){
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(()=> t.classList.remove('show'), 2600);
}

/* ---------- CALENDARI ---------- */
function renderCalendar(){
  const label = document.getElementById('calMonthLabel');
  label.textContent = MONTH_NAMES[calMonthCursor.getMonth()] + " " + calMonthCursor.getFullYear();
  const grid = document.getElementById('calGrid');
  grid.innerHTML = "";
  DOW_NAMES.forEach(n=>{
    const el = document.createElement('div');
    el.className = 'cal-dow';
    el.textContent = n.slice(0,3);
    grid.appendChild(el);
  });

  const year = calMonthCursor.getFullYear();
  const month = calMonthCursor.getMonth();
  const firstDay = new Date(year, month, 1);
  const startOffset = isoWeekday(firstDay) - 1; // dilluns=0
  const daysInMonth = new Date(year, month+1, 0).getDate();
  const todayIso = isoDate(new Date());

  const sessionsByDate = {};
  sessions.forEach(s => { sessionsByDate[s.date] = s; });

  for(let i=0;i<startOffset;i++){
    const el = document.createElement('div');
    el.className = 'cal-cell empty';
    grid.appendChild(el);
  }
  for(let d=1; d<=daysInMonth; d++){
    const dateObj = new Date(year, month, d);
    const wd = isoWeekday(dateObj);
    const dt = dayTypeForWeekday(wd);
    const iso = isoDate(dateObj);
    const cell = document.createElement('div');
    let cls = 'cal-cell';
    if(dt) cls += ' training';
    if(iso === todayIso) cls += ' today';
    if(sessionsByDate[iso]) cls += ' done';
    cell.className = cls;
    cell.innerHTML = `<span>${d}</span>` + (dt ? `<span class="dtag">D${dt}</span>` : '');
    grid.appendChild(cell);
  }
}
document.getElementById('prevMonth').addEventListener('click', ()=>{
  calMonthCursor = new Date(calMonthCursor.getFullYear(), calMonthCursor.getMonth()-1, 1);
  renderCalendar();
});
document.getElementById('nextMonth').addEventListener('click', ()=>{
  calMonthCursor = new Date(calMonthCursor.getFullYear(), calMonthCursor.getMonth()+1, 1);
  renderCalendar();
});

/* ---------- PROGRÉS SETMANAL ---------- */
function currentWeekRange(){
  const now = new Date();
  const wd = isoWeekday(now);
  const monday = new Date(now);
  monday.setDate(now.getDate() - (wd - 1));
  monday.setHours(0,0,0,0);
  const sunday = new Date(monday);
  sunday.setDate(monday.getDate()+6);
  sunday.setHours(23,59,59,999);
  return [monday, sunday];
}
function renderWeekProgress(){
  const [mon, sun] = currentWeekRange();
  const count = sessions.filter(s=>{
    const d = new Date(s.date+"T12:00:00");
    return d >= mon && d <= sun;
  }).length;
  const capped = Math.min(count,3);
  const circumference = 264;
  const offset = circumference - (capped/3)*circumference;
  document.getElementById('ringFg').setAttribute('stroke-dashoffset', offset);
  document.getElementById('ringText').textContent = capped+"/3";
  document.getElementById('statWeek').textContent = capped+"/3";
}

/* ---------- ESTADÍSTIQUES ---------- */
function renderStats(){
  document.getElementById('statTotal').textContent = sessions.length;
  const totalMin = sessions.reduce((a,s)=>a+s.minutes,0);
  document.getElementById('statMinutes').textContent = totalMin;
  document.getElementById('statAvg').textContent = sessions.length ? Math.round(totalMin/sessions.length) : 0;

  // gràfic per setmana (últimes 8 setmanes)
  const weeks = [];
  const now = new Date();
  for(let i=7;i>=0;i--){
    const ref = new Date(now);
    ref.setDate(now.getDate() - i*7);
    const wd = isoWeekday(ref);
    const monday = new Date(ref); monday.setDate(ref.getDate()-(wd-1)); monday.setHours(0,0,0,0);
    const sunday = new Date(monday); sunday.setDate(monday.getDate()+6); sunday.setHours(23,59,59,999);
    const mins = sessions.filter(s=>{
      const d = new Date(s.date+"T12:00:00");
      return d>=monday && d<=sunday;
    }).reduce((a,s)=>a+s.minutes,0);
    weeks.push({label: (monday.getDate())+"/"+(monday.getMonth()+1), mins});
  }
  const maxMin = Math.max(...weeks.map(w=>w.mins), 1);
  const barsEl = document.getElementById('barsChart');
  barsEl.innerHTML = "";
  weeks.forEach(w=>{
    const col = document.createElement('div');
    col.className = 'bar-col';
    col.innerHTML = `<div class="bar" style="height:${(w.mins/maxMin*100)}%"></div><div class="bl">${w.label}</div>`;
    barsEl.appendChild(col);
  });

  // historial
  const wrap = document.getElementById('historyWrap');
  if(!sessions.length){
    wrap.innerHTML = '<div class="empty-state">Encara no hi ha sessions registrades. Comença la teva primera sessió avui.</div>';
    return;
  }
  const sorted = [...sessions].sort((a,b)=> new Date(b.start) - new Date(a.start)).slice(0,15);
  let rows = sorted.map(s=>{
    const d = new Date(s.date+"T12:00:00");
    return `<tr>
      <td>${d.toLocaleDateString('ca-ES',{day:'numeric',month:'short',year:'numeric'})}</td>
      <td>Dia ${s.dayType}</td>
      <td>${s.minutes} min</td>
      <td>${s.exercisesDone} / ${s.totalExercises}</td>
    </tr>`;
  }).join('');
  wrap.innerHTML = `<table class="history">
    <thead><tr><th>Data</th><th>Sessió</th><th>Durada</th><th>Exercicis</th></tr></thead>
    <tbody>${rows}</tbody>
  </table>`;
}

/* ---------- INICI ---------- */
async function init(){
  await ensureCode();
  document.getElementById('footerCode').textContent = personalCode;
  await loadSettings();
  await loadSessions();
  populateDaySelectors();
  renderToday();
  renderCalendar();
  renderStats();
  renderWeekProgress();
}
init();
</script>
